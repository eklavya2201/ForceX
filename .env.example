FORCEX_SECRET_KEY=change-me-to-64-random-hex-chars
FORCEX_CLIENT_KEY=change-me-to-a-different-64-random-hex-chars
FORCEX_DB=sqlite:///forcex.db
FORCEX_MAX_UPLOAD_MB=500
FORCEX_VIEW_TTL_MIN=10
FORCEX_DOWNLOAD_TTL_MIN=5
FORCEX_COOKIE_SECURE=0

# Download URLs shown to receivers on the gate page and to senders on the created page.
# Set these to the actual GitHub Releases URLs once you have built and uploaded the apps.
# FORCEX_DESKTOP_DOWNLOAD_URL=https://github.com/eklavya2201/ForceX/releases/latest/download/ForceX.exe
# FORCEX_ANDROID_DOWNLOAD_URL=https://github.com/eklavya2201/ForceX/releases/latest/download/ForceX.apk

# Optional: disable new sender registrations once the team is onboarded.
# FORCEX_ALLOW_REGISTRATION=0

# Set to 1 when running behind a reverse proxy (Nginx, Vercel, Render, etc.)
# so the real client IP is read from X-Forwarded-For.
# FORCEX_BEHIND_PROXY=1

# ── Client Build Variables ────────────────────────────────────────────────
# These are used when building the Windows EXE (build_desktop.py) or the
# Android APK (Gradle build). They are injected via CI secrets and must
# never be committed. The CLIENT_KEY here must match FORCEX_CLIENT_KEY above.
# FORCEX_URL=https://your-forcex-site.example.com
# FORCEX_CLIENT_KEY=must-match-server-FORCEX_CLIENT_KEY
